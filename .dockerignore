.git
.github

# ============================================================
# Secretos: nunca deben entrar en la imagen
# ============================================================
.env
.env.*
!.env.example

# ============================================================
# Dependencias (se reinstalan dentro de la imagen)
# ============================================================
node_modules
vendor

# ============================================================
# Datos locales: esto es informacion real de la empresa
# ============================================================
# Adjuntos de pedidos (PDF/JPG) e importaciones de precios que estan
# en la maquina de desarrollo. Sin esto se horneaban en la imagen.
storage/app/private/*
!storage/app/private/.gitignore
storage/app/public/*
!storage/app/public/.gitignore
storage/debugbar/*
!storage/debugbar/.gitignore
storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
storage/framework/testing/*
# El cache de Laravel se regenera en cada arranque (entrypoint) y el
# del host es de otra maquina.
bootstrap/cache/*
!bootstrap/cache/.gitignore

public/storage

# ============================================================
# Artefactos locales
# ============================================================
# El bundle de Vite se compila en el stage de Node; mandar el del
# host solo anade peso y puede meter un build viejo en la capa.
public/build
public/hot
# Base sqlite del entorno de desarrollo
database/*.sqlite
database/*.sqlite-journal
database/*.db

# ============================================================
# Ruido de herramientas
# ============================================================
npm-debug.log
yarn-debug.log
yarn-error.log

# El propio contenedor y su orquestador
Dockerfile
Dockerfile.*
docker-compose.yml
compose.yaml
.dockerignore

# Herramientas de desarrollo
.idea
.vscode
.phpunit.result.cache
.phpunit.cache
tests
# Datos de pruebas que el agente/editor deja junto al codigo
.opencode
opencode.json
AGENTS.md
